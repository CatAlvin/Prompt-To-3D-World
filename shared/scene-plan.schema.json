{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-to-3d-world.local/schemas/scene-plan-1.0.0.json",
  "title": "Prompt To 3D World Scene Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "archetype",
    "visualDirection",
    "seed",
    "styleKit",
    "time",
    "weather",
    "density",
    "scale",
    "mainPath",
    "zones",
    "heroAnchors",
    "mustInclude",
    "avoid"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "archetype": {
      "type": "string",
      "enum": ["urban_alley", "cozy_room", "misty_nature", "desert_outpost", "historic_town", "lunar_station"]
    },
    "visualDirection": { "type": "string", "minLength": 8, "maxLength": 180 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "styleKit": {
      "type": "string",
      "enum": ["cyberpunk_tokyo_v1", "cozy_lowpoly_v1", "misty_nature_v1", "lunar_research_v1"]
    },
    "time": { "type": "string", "enum": ["auto", "day", "sunrise", "sunset", "night", "indoor"] },
    "weather": { "type": "string", "enum": ["auto", "clear", "rain", "mist", "dust"] },
    "density": { "type": "number", "minimum": 0.2, "maximum": 1 },
    "scale": { "type": "string", "enum": ["compact", "medium", "wide"] },
    "mainPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "width", "length"],
      "properties": {
        "shape": { "type": "string", "enum": ["straight", "bent", "courtyard", "loop"] },
        "width": { "type": "number", "minimum": 1.8, "maximum": 10 },
        "length": { "type": "number", "minimum": 10, "maximum": 80 }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "side", "weight"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,31}$" },
          "purpose": { "type": "string", "maxLength": 48 },
          "side": { "type": "string", "enum": ["left", "right", "center", "around"] },
          "weight": { "type": "number", "minimum": 0.1, "maximum": 1 }
        }
      }
    },
    "heroAnchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 2, "maxLength": 48 }
    },
    "mustInclude": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 48 }
    },
    "avoid": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 48 }
    }
  }
}
