{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-to-3d-world.local/schemas/scene-3.0.0.json",
  "title": "Prompt To 3D World Scene 3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "seed",
    "units",
    "environment",
    "camera",
    "nodes",
    "metadata",
    "pipeline",
    "semanticReport",
    "extensions"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "3.0.0" },
    "id": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "units": { "type": "string", "const": "meters" },
    "environment": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/environment" },
    "camera": { "$ref": "#/$defs/camera" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 320,
      "items": {
        "oneOf": [
          {
            "allOf": [
              { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/primitiveNode" },
              { "required": ["provenance"] }
            ]
          },
          {
            "allOf": [
              { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/textNode" },
              { "required": ["provenance"] }
            ]
          },
          {
            "allOf": [
              { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/lightNode" },
              { "required": ["provenance"] }
            ]
          },
          {
            "allOf": [
              { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/groupNode" },
              { "required": ["provenance"] }
            ]
          },
          { "$ref": "#/$defs/effectNode" }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "promptLanguage"],
      "properties": {
        "generator": { "type": "string", "const": "visual-recipe-compiler" },
        "promptLanguage": { "type": "string", "enum": ["zh", "en", "mixed", "unknown"] }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionKind",
        "intentVersion",
        "compilerVersion",
        "styleKit",
        "quality",
        "sceneMode",
        "requestFingerprint",
        "capabilityVersions"
      ],
      "properties": {
        "versionKind": { "type": "string", "enum": ["draft", "final"] },
        "intentVersion": { "type": "string", "const": "2.0.0" },
        "compilerVersion": { "type": "string", "const": "visual-recipes-3.0.0" },
        "styleKit": {
          "type": "string",
          "enum": ["cyberpunk_tokyo_v1", "cozy_lowpoly_v1", "misty_nature_v1", "lunar_research_v1"]
        },
        "quality": { "type": "string", "enum": ["draft", "balanced", "quality"] },
        "sceneMode": {
          "type": "string",
          "enum": ["walkable", "interior", "orbital", "flythrough", "diorama", "panorama"]
        },
        "requestFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "capabilityVersions": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 24 }
        }
      }
    },
    "semanticReport": { "$ref": "#/$defs/semanticReport" },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weather", "wetness"],
      "properties": {
        "weather": { "type": "string", "enum": ["clear", "rain", "mist", "dust"] },
        "wetness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "$defs": {
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "position", "lookAt", "fov", "near", "far", "movement"],
      "properties": {
        "mode": { "type": "string", "enum": ["firstPerson", "orbit", "fly", "panorama"] },
        "position": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/vector3" },
        "lookAt": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/vector3" },
        "fov": { "type": "number", "minimum": 40, "maximum": 90 },
        "near": { "type": "number", "minimum": 0.01, "maximum": 1 },
        "far": { "type": "number", "minimum": 20, "maximum": 2000 },
        "movement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["speed", "sprintMultiplier", "eyeHeight"],
          "properties": {
            "speed": { "type": "number", "minimum": 1, "maximum": 12 },
            "sprintMultiplier": { "type": "number", "minimum": 1, "maximum": 3 },
            "eyeHeight": { "type": "number", "minimum": 1, "maximum": 2.2 },
            "baseElevation": { "type": "number", "minimum": -10, "maximum": 40 }
          }
        }
      }
    },
    "effectNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subtype", "parentId", "transform", "parameters", "semantics", "provenance"],
      "properties": {
        "id": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/id" },
        "kind": { "type": "string", "const": "effect" },
        "subtype": { "type": "string", "enum": ["starfield", "star", "pulsar", "black_hole", "planet", "crater", "cloud_field"] },
        "parentId": {
          "oneOf": [
            { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "transform": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/transform" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "color", "secondaryColor", "size", "intensity", "radius", "spread", "rotationSpeed"],
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 2000 },
            "color": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/color" },
            "secondaryColor": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/color" },
            "size": { "type": "number", "minimum": 0.01, "maximum": 40 },
            "intensity": { "type": "number", "minimum": 0, "maximum": 12 },
            "radius": { "type": "number", "minimum": 0.1, "maximum": 200 },
            "spread": { "type": "number", "minimum": 1, "maximum": 1000 },
            "rotationSpeed": { "type": "number", "minimum": -5, "maximum": 5 }
          }
        },
        "semantics": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/semantics" },
        "provenance": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/provenance" }
      }
    },
    "semanticReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requiredCoverage",
        "relationSatisfaction",
        "forbiddenViolations",
        "unrelatedRatio",
        "heroVisible",
        "coveredEntityIds",
        "missingEntityIds"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "passed", "failed"] },
        "requiredCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "relationSatisfaction": { "type": "number", "minimum": 0, "maximum": 1 },
        "forbiddenViolations": { "type": "integer", "minimum": 0 },
        "unrelatedRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "heroVisible": { "type": "boolean" },
        "coveredEntityIds": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "missingEntityIds": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
