{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-to-3d-world.local/schemas/scene-intent-2.0.0.json",
  "title": "Prompt To 3D World Scene Intent 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "sceneMode",
    "environment",
    "entities",
    "relations",
    "constraints",
    "cameraIntent",
    "styleIntent",
    "quality",
    "seed"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "sceneMode": {
      "type": "string",
      "enum": ["walkable", "interior", "orbital", "flythrough", "diorama", "panorama"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "weather", "atmosphere"],
      "properties": {
        "time": { "type": "string", "enum": ["auto", "day", "sunrise", "sunset", "night", "indoor"] },
        "weather": { "type": "string", "enum": ["auto", "clear", "rain", "mist", "dust"] },
        "atmosphere": { "type": "string", "maxLength": 100 }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/entity" }
    },
    "relations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/relation" }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredEntities",
        "forbiddenConcepts",
        "optionalEntities",
        "maxUnrelatedObjects",
        "preserveOpenSpace",
        "navigationRequired"
      ],
      "properties": {
        "requiredEntities": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "forbiddenConcepts": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "optionalEntities": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "maxUnrelatedObjects": { "type": "integer", "minimum": 0, "maximum": 8 },
        "preserveOpenSpace": { "type": "boolean" },
        "navigationRequired": { "type": "boolean" }
      }
    },
    "cameraIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroEntityId", "framing", "viewDirection"],
      "properties": {
        "heroEntityId": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "framing": { "type": "string", "enum": ["close", "medium", "wide"] },
        "viewDirection": { "type": "string", "maxLength": 100 }
      }
    },
    "styleIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["styleKit", "mood"],
      "properties": {
        "styleKit": {
          "type": "string",
          "enum": ["auto", "cyberpunk_tokyo_v1", "cozy_lowpoly_v1", "misty_nature_v1", "lunar_research_v1"]
        },
        "mood": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "quality": { "type": "string", "enum": ["draft", "balanced", "quality"] },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,47}$" },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "concept", "category", "role", "importance", "count", "attributes", "sourceText"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "concept": { "type": "string", "minLength": 1, "maxLength": 64 },
        "category": {
          "type": "string",
          "enum": ["celestial", "environment", "architecture", "nature", "prop", "effect", "abstract"]
        },
        "role": { "type": "string", "enum": ["hero", "supporting", "background", "structural"] },
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "count": { "type": "integer", "minimum": 1, "maximum": 20 },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color", "size", "label", "state", "brightness"],
          "properties": {
            "color": { "type": ["string", "null"], "maxLength": 32 },
            "size": { "type": ["string", "null"], "enum": ["tiny", "small", "medium", "large", "massive", null] },
            "label": { "type": ["string", "null"], "maxLength": 40 },
            "state": { "type": ["string", "null"], "maxLength": 40 },
            "brightness": { "type": ["number", "null"], "minimum": 0, "maximum": 10 }
          }
        },
        "sourceText": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "type", "targetId", "strength"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "type": {
          "type": "string",
          "enum": [
            "left_of",
            "right_of",
            "in_front_of",
            "behind",
            "near",
            "far_from",
            "inside",
            "around",
            "orbiting",
            "above",
            "below",
            "facing",
            "connected_to"
          ]
        },
        "targetId": { "$ref": "#/$defs/id" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
