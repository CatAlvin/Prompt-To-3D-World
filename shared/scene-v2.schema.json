{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-to-3d-world.local/schemas/scene-2.0.0.json",
  "title": "Prompt To 3D World Scene 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "seed", "units", "environment", "camera", "nodes", "metadata", "pipeline", "extensions"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0.0" },
    "id": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "units": { "type": "string", "const": "meters" },
    "environment": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/environment" },
    "camera": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/camera" },
    "nodes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 320,
      "items": {
        "oneOf": [
          { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/primitiveNode" },
          { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/textNode" },
          { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/lightNode" },
          { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/groupNode" },
          { "$ref": "#/$defs/proceduralNode" },
          { "$ref": "#/$defs/assetNode" },
          { "$ref": "#/$defs/prefabNode" },
          { "$ref": "#/$defs/instancesNode" },
          { "$ref": "#/$defs/decalNode" }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "promptLanguage"],
      "properties": {
        "generator": { "type": "string", "minLength": 1, "maxLength": 40 },
        "promptLanguage": { "type": "string", "enum": ["zh", "en", "mixed", "unknown"] }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionKind", "planVersion", "compilerVersion", "styleKit", "quality", "archetype", "requestFingerprint"],
      "properties": {
        "versionKind": { "type": "string", "enum": ["draft", "final"] },
        "planVersion": { "type": "string", "const": "1.0.0" },
        "compilerVersion": { "type": "string", "enum": ["procedural-2.0.0", "procedural-2.0.1"] },
        "styleKit": { "type": "string", "enum": ["cyberpunk_tokyo_v1", "cozy_lowpoly_v1", "misty_nature_v1", "lunar_research_v1"] },
        "quality": { "type": "string", "enum": ["draft", "balanced", "quality"] },
        "archetype": { "type": "string", "enum": ["urban_alley", "cozy_room", "misty_nature", "desert_outpost", "historic_town", "lunar_station"] },
        "requestFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weather": { "type": "string", "enum": ["clear", "rain", "mist", "dust"] },
        "wetness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "$defs": {
    "parentId": {
      "oneOf": [
        { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/id" },
        { "type": "null" }
      ]
    },
    "proceduralNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subtype", "parentId", "transform", "generator", "parameters", "semantics", "fallback"],
      "properties": {
        "id": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/id" },
        "kind": { "type": "string", "const": "procedural" },
        "subtype": { "type": "string", "enum": ["building_row", "shopfront_row", "tree_cluster", "rock_cluster", "interior_shell", "prop_scatter"] },
        "parentId": { "$ref": "#/$defs/parentId" },
        "transform": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/transform" },
        "generator": { "type": "string", "enum": ["building_row_v1", "shopfront_row_v1", "tree_cluster_v1", "rock_cluster_v1", "interior_shell_v1", "prop_scatter_v1"] },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "spacing", "spread", "height"],
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 80 },
            "spacing": { "type": "number", "minimum": 0.2, "maximum": 20 },
            "spread": { "type": "number", "minimum": 0.2, "maximum": 80 },
            "height": { "type": "number", "minimum": 0.2, "maximum": 40 }
          }
        },
        "semantics": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/semantics" },
        "fallback": { "type": "string", "enum": ["boxes", "cylinders", "spheres"] }
      }
    },
    "assetNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subtype", "parentId", "transform", "assetRef", "variant", "lod", "semantics", "collision", "fallback"],
      "properties": {
        "id": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/id" },
        "kind": { "type": "string", "const": "asset" },
        "subtype": { "type": "string", "const": "catalog_asset" },
        "parentId": { "$ref": "#/$defs/parentId" },
        "transform": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/transform" },
        "assetRef": { "type": "string", "enum": ["asset_paper_lantern_v1", "asset_street_lamp_v1", "asset_wood_crate_v1", "asset_rock_v1", "asset_shrub_v1", "asset_lunar_antenna_v1"] },
        "variant": { "type": "string", "maxLength": 32 },
        "lod": { "type": "integer", "minimum": 0, "maximum": 2 },
        "semantics": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/semantics" },
        "collision": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/collision" },
        "fallback": { "type": "string", "enum": ["box", "sphere", "cylinder"] }
      }
    },
    "prefabNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subtype", "parentId", "transform", "prefabRef", "semantics"],
      "properties": {
        "id": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/id" },
        "kind": { "type": "string", "const": "prefab" },
        "subtype": { "type": "string", "const": "registered_prefab" },
        "parentId": { "$ref": "#/$defs/parentId" },
        "transform": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/transform" },
        "prefabRef": { "type": "string", "enum": ["prefab_shopfront_v1", "prefab_shrine_gate_v1", "prefab_cozy_window_v1", "prefab_lunar_module_v1"] },
        "semantics": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/semantics" }
      }
    },
    "instancesNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subtype", "parentId", "transform", "source", "instances", "semantics"],
      "properties": {
        "id": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/id" },
        "kind": { "type": "string", "const": "instances" },
        "subtype": { "type": "string", "const": "primitive_instances" },
        "parentId": { "$ref": "#/$defs/parentId" },
        "transform": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/transform" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primitive", "material"],
          "properties": {
            "primitive": { "type": "string", "enum": ["box", "sphere", "cylinder"] },
            "material": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/material" }
          }
        },
        "instances": { "type": "array", "minItems": 1, "maxItems": 120, "items": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/transform" } },
        "semantics": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/semantics" }
      }
    },
    "decalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subtype", "parentId", "transform", "material", "semantics"],
      "properties": {
        "id": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/id" },
        "kind": { "type": "string", "const": "decal" },
        "subtype": { "type": "string", "enum": ["puddle", "marking", "poster" ] },
        "parentId": { "$ref": "#/$defs/parentId" },
        "transform": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/transform" },
        "material": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/material" },
        "semantics": { "$ref": "https://prompt-to-3d-world.local/schemas/scene-1.0.0.json#/$defs/semantics" }
      }
    }
  }
}
