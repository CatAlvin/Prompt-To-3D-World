APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8010
CORS_ORIGINS=http://localhost:5173

# Kimi API. Keep the real key only in .env.
LLM_PROVIDER=kimi
MOONSHOT_API_KEY=
# Use api.moonshot.cn for China-region keys, or api.moonshot.ai for global keys.
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=240
LLM_MAX_OUTPUT_TOKENS=12000
GENERATION_TIMEOUT_SECONDS=360
V2_INLINE_WORKER=true

# Local MySQL 8
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=prompt_to_3d_world

# Anonymous V1 sessions
ANONYMOUS_RETENTION_DAYS=30
GENERATION_RATE_LIMIT_PER_MINUTE=10
